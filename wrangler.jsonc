{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lostnfound-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lostnfound",
      "database_id": "91e6f2fd-66b8-48fa-b77f-723f9c359f11",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lostnfound-uploads"
    }
  ]
}
